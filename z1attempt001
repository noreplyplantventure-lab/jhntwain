   const v = val.toLowerCase()
   if(v.indexOf('close') !== -1) return '#00ccaa'
   if(v.indexOf('medium') !== -1) return '#ffaa00'
   if(v.indexOf('far') !== -1) return '#ff5555'
   return '#556677'
