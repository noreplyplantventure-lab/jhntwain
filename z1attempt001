    U.regCss(card, {
     position:'absolute', transform:'translate('+pos.x+'px,'+pos.y+'px)'
    })
    const body = card._bodyEl
    const attrKeys = Object.keys(ent.attrs)
    let shown = 0
    for(let j = 0; j < attrKeys.length; j++){
     const key = attrKeys[j]
     if(key === 'name') continue
     const row = U.crtEl('div','jtw-card-attr-row')
