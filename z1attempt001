const JhnTwainUIX = (function(U, S){
const tabDefs = [
 {key:'seed', label:'🌱 Seed', short:'Seed'},
 {key:'prose', label:'✍️ Prose', short:'Prose'},
 {key:'chars', label:'👤 Chars', short:'Chars', entTy:'character'},
