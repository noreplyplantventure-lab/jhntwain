 }
 function parseTextToEntities(txt){
  const results = []
  const lines = txt.split('\n')
  let curEnt = null
  let curAttr = null
  let proseBuffer = ''
  let inProse = false
  for(let i = 0; i < lines.length; i++){
   const line = lines[i]
   const trimmed = line.trim()
   if(inProse){
    if(trimmed === '' && i+1 < lines.length && !lines[i+1].trim().startsWith(' ')){
     if(curEnt && curAttr){
      curEnt.attrs[curAttr] = proseBuffer.trim()
      curAttr = null
     }
     inProse = false
     proseBuffer = ''
    } else {
     proseBuffer += line + '\n'
     continue
    }
   }
   if(trimmed.startsWith('@')){
    if(curEnt) results.push(curEnt)
    const parts = trimmed.split(/\s+/)
    const prefix = parts[0]
    const name = parts.slice(1).join(' ')
    curEnt = {type:prefix, id:name||prefix, attrs:{}}
    curAttr = null
   } else if(trimmed.startsWith('#') || trimmed.startsWith('!') || trimmed === ''){
    continue
   } else if(curEnt && trimmed.includes(' ')){
    const spaceIdx = trimmed.indexOf(' ')
    const attrKey = trimmed.substring(0, spaceIdx)
    const attrVal = trimmed.substring(spaceIdx+1).replace(/^"|"$/g,'')
    if(attrVal === ''){
     curAttr = attrKey
     inProse = true
     proseBuffer = ''
    } else {
     curEnt.attrs[attrKey] = attrVal
     curAttr = null
    }
   } else if(curEnt){
    curAttr = trimmed
    inProse = true
    proseBuffer = ''
   }
  }
  if(curEnt) results.push(curEnt)
  return results
 }
 function drawLink(canvas, srcEl, tgtEl, typ){
  if(!canvas || !srcEl || !tgtEl) return
  const ctx = canvas.getContext('2d')
  if(!ctx) return
  const srcR = srcEl.getBoundingClientRect()
  const tgtR = tgtEl.getBoundingClientRect()
  const cR = canvas.getBoundingClientRect()
  const sx = srcR.left + srcR.width/2 - cR.left
  const sy = srcR.top + srcR.height/2 - cR.top
  const tx = tgtR.left + tgtR.width/2 - cR.left
  const ty = tgtR.top + tgtR.height/2 - cR.top
  const cp1x = sx
  const cp1y = sy + (ty - sy) * 0.4
  const cp2x = tx
  const cp2y = ty - (ty - sy) * 0.4
  ctx.beginPath()
  ctx.moveTo(sx, sy)
  ctx.bezierCurveTo(cp1x, cp1y, cp2x, cp2y, tx, ty)
  const colors = {involves:'#00ccaa',conflict:'#ff5555',thread:'#88ccff',default:'#556677'}
  ctx.strokeStyle = colors[typ] || colors.default
  ctx.lineWidth = 2
  ctx.setLineDash([6,4])
  ctx.globalAlpha = 0.6
  ctx.stroke()
  ctx.globalAlpha = 1
 }
 let modalOverlay = null
 function showModal(content, actions){
  hideModal()
  modalOverlay = Utils.crtEl('div','jtw-modal-overlay')
  Utils.regCss(modalOverlay,{
   position:'fixed', top:'0', left:'0', width:'100%', height:'100%',
   background:'rgba(0,0,0,0.7)', display:'flex', alignItems:'center',
