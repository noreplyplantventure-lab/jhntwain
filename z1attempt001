/* ===== Utils ========================================================= */
const Utils = (function(){
const cssRgstry = {props:[], map:new Map()}
function getOrAddPropIdx(pn){
 let i = cssRgstry.props.indexOf(pn)
 if(i === -1){ i = cssRgstry.props.length; cssRgstry.props.push(pn) }
 return i
}
function regCss(el, o){
 if(!el || !o) return el
 let e = cssRgstry.map.get(el)
 if(!e){ e = [[],[]]; cssRgstry.map.set(el, e) }
 Object.keys(o).forEach(k=>{
  const pi = getOrAddPropIdx(k), v = o[k]
  const j = e[0].indexOf(pi)
  j === -1 ? (e[0].push(pi), e[1].push(v)) : (e[1][j] = v)
 })
 const rule = cssRgstry.props.map((p,i)=>p+':'+e[1][e[0].indexOf(i)]+';').join('')
 el.style.cssText = rule
 return el
}
function crtEl(t, c, txt){
 const el = document.createElement(t)
 if(c) el.className = c
 if(txt) el.appendChild(document.createTextNode(txt))
 return el
}
function appndChld(p, ...ch){ ch.forEach(c=>c && p.appendChild(c)); return p }
function clrChld(el){ while(el.firstChild) el.removeChild(el.firstChild); return el }
const evBus = {}
function pub(t, d){ (evBus[t] || []).forEach(fn=>fn(d)) }
function sub(t, fn){ (evBus[t] ||= []).push(fn); return ()=>{ const i = evBus[t].indexOf(fn); if(i>-1) evBus[t].splice(i,1) } }
function save(k, v){ try{ localStorage.setItem('jtw_'+k, JSON.stringify(v)) }catch{} }
function load(k){ try{ return JSON.parse(localStorage.getItem('jtw_'+k)) }catch{return null} }
function dragInit(el, cbs){
 let drag = false, sx = 0, sy = 0, ox = 0, oy = 0
 function onDown(e){
  if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.isContentEditable) return
  drag = true; const t = e.touches ? e.touches[0] : e
  sx = t.clientX; sy = t.clientY; ox = parseInt(el.dataset.x) || 0; oy = parseInt(el.dataset.y) || 0
  regCss(el, {zIndex:'10', boxShadow:'0 8px 24px rgba(0,204,170,0.25)'})
  e.preventDefault()
 }
 function onMove(e){
  if(!drag) return; const t = e.touches ? e.touches[0] : e
  const nx = ox + (t.clientX - sx), ny = oy + (t.clientY - sy)
  el.dataset.x = nx; el.dataset.y = ny
  regCss(el, {transform:`translate(${nx}px,${ny}px)`})
 }
 function onUp(){ if(!drag) return; drag = false; regCss(el, {zIndex:'1', boxShadow:'0 2px 8px rgba(0,0,0,0.3)'}) }
 el.addEventListener('mousedown', onDown)
 document.addEventListener('mousemove', onMove)
 document.addEventListener('mouseup', onUp)
 el.addEventListener('touchstart', onDown, {passive:false})
 document.addEventListener('touchmove', onMove, {passive:false})
 document.addEventListener('touchend', onUp)
 return {destroy:()=>{ el.removeEventListener('mousedown', onDown); document.removeEventListener('mousemove', onMove); document.removeEventListener('mouseup', onUp) } }
}
function countWords(txt){ return txt ? txt.trim().split(/\s+/).filter(w=>w).length : 0 }
return {crtEl, appndChld, clrChld, regCss, pub, sub, save, load, dragInit, countWords}
})()

