 U.appndChld(card, hdr, badge, body)
 card._id = ent.id; card._del = del; card._body = body; card._ttl = ttl
 return card
}
function parseEAS(txt){
 const res = [], lines = txt.split('\n')
 let cur = null, curAttr = null, proseBuf = '', inProse = false
 lines.forEach(l=>{
  const ln = l.trim()
  if(inProse){
   if(ln === '' && !l.startsWith(' ')){ if(cur && curAttr){ cur.attrs[curAttr] = proseBuf.trim(); curAttr = null } inProse = false; proseBuf = '' } else { proseBuf += l + '\n'; return }
  }
  if(ln.startsWith('@')){
   if(cur) res.push(cur)
   const [pfx, ...rest] = ln.split(/\s+/), name = rest.join(' ')
   cur = {type:pfx, id:name||pfx, attrs:{}}
   curAttr = null
  }else if(ln.startsWith('#') || ln.startsWith('!') || ln === ''){
   /* ignore */
  }else if(cur && ln.includes(' ')){
   const sp = ln.indexOf(' '), k = ln.slice(0,sp), v = ln.slice(sp+1).replace(/^"|"$/g,'')
   if(v === ''){ curAttr = k; inProse = true; proseBuf = '' } else { cur.attrs[k] = v; curAttr = null }
  }else if(cur){
   curAttr = ln; inProse = true; proseBuf = ''
  }
 })
 if(cur) res.push(cur)
 return res
}
function modal(content, actions){
 const ov = U.crtEl('div','jtw-modal-overlay')
 U.regCss(ov,{position:'fixed',top:0,left:0,width:'100%',height:'100%',background:'rgba(0,0,0,0.7)',display:'flex',alignItems:'center',justifyContent:'center',zIndex:'9999',animation:'jtwFadeIn 0.2s ease'})
 const m = U.crtEl('div','jtw-modal')
 U.regCss(m,{background:'linear-gradient(135deg, #1e2436 0%, #151a28 100%)',borderRadius:'14px',padding:'28px',minWidth:'340px',maxWidth:'560px',maxHeight:'80vh',overflowY:'auto',boxShadow:'0 12px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05)',color:'#e0e4ec',animation:'jtwSlideUp 0.3s ease'})
 if(typeof content === 'string'){ const t = U.crtEl('div','jtw-modal-txt'); t.textContent = content; U.regCss(t,{marginBottom:'16px',lineHeight:'1.6',whiteSpace:'pre-wrap'}); m.appendChild(t) } else m.appendChild(content)
 if(actions?.length){ const r = U.crtEl('div','jtw-modal-acts'); U.regCss(r,{display:'flex',gap:'8px',justifyContent:'flex-end',marginTop:'20px'}); actions.forEach(a=>{ const b = U.crtEl('button','jtw-modal-act-btn'); b.textContent = a.label; U.regCss(b,{padding:'10px 20px',borderRadius:'8px',border:'none',cursor:'pointer',fontSize:'13px',fontWeight:'500',background:a.primary?'linear-gradient(135deg, #00ccaa 0%, #00a88a 100%)':'#2a3040',color:a.primary?'#0a0e14':'#e0e4ec'}); b.addEventListener('click', a.fn); r.appendChild(b) }); m.appendChild(r) }
 ov.appendChild(m); ov.addEventListener('click', e=>{ if(e.target === ov) ov.remove() }); document.body.appendChild(ov); return ov
}
return {createCard, parseEAS, modal, toast}
})()

/* ===== JhnTwainState ================================================= */
const JhnTwainState = (function(){
let data = { seed:{title:'',target:5000,theme:'',premise:'',seedTxt:''}, entities:new Map(), proseBlks:[], relations:[], harmny:{ conductor:{harmony:50,tempo:'steady',openThreads:[]}, narrTrain:{momentum:'building',nextBeat:'inciting-incident'}, multiverse:{branches:[],violations:[]} } }
const listeners = [], MAX_HISTORY = 50
let history = [], historyIdx = -1, paused = false
function get(path){ if(!path) return data; return path.split('.').reduce((o,k)=>o?.[k], data) }
function set(path, val){ const parts = path.split('.'), last = parts.pop(); const obj = parts.reduce((o,k)=>o[k]??={}, data); obj[last] = val; notify() }
function addEnt(ty, init){ const id = ty + '-' + Date.now().toString(36) + Math.random().toString(36).substr(2,4); const ent = {id, type:ty, meta:{created:Date.now(),modified:Date.now()}, attrs:{name:'',...init}, color:getColor(ty), icon:getIcon(ty)}; data.entities.set(id, ent); notify(); return ent }
function updEnt(id, ch){ const e = data.entities.get(id); if(!e) return; Object.assign(e.attrs, ch.attrs || {}); e.meta.modified = Date.now(); notify() }
function delEnt(id){ data.entities.delete(id); data.relations = data.relations.filter(r=>r.src!==id && r.tgt!==id); notify() }
function lnkEnts(src, tgt, typ){ data.relations.push({src, tgt, type:typ||'involves'}); notify() }
function getEntsByTy(ty){ const r=[]; data.entities.forEach(e=>{ if(e.type===ty) r.push(e) }); return r }
function getAllEnts(){ const arr=[]; data.entities.forEach(e=>arr.push(e)); return arr }
function getRels(){ return data.relations }
function getColor(ty){ const c={character:'#00ccaa',scene:'#ffaa00',conflict:'#ff5555',research:'#7777ff',storycard:'#cc88ff',thread:'#88ccff',conductor:'#ffff77',narrTrain:'#ff77aa',multiverse:'#aa77ff'}; return c[ty] || '#00ccaa' }
function getIcon(ty){ const i={character:'👤',scene:'📍',conflict:'⚔️',research:'📚',storycard:'🃏',thread:'🔗',conductor:'🎼',narrTrain:'🚂',multiverse:'🌌'}; return i[ty] || '●' }
function getTotalWordCount(){ let t = 0; data.proseBlks.forEach(b=> t += Utils.countWords(b.text)); t += Utils.countWords(data.seed.seedTxt); return t }
function exportData(){ return JSON.stringify({seed:data.seed, entities:Array.from(data.entities.entries()), proseBlks:data.proseBlks, relations:data.relations, harmny:data.harmny}) }
function importData(str){ try{ const d = JSON.parse(str); if(d.seed) data.seed = d.seed; if(d.entities) data.entities = new Map(d.entities); if(d.proseBlks) data.proseBlks = d.proseBlks; if(d.relations) data.relations = d.relations; if(d.harmny) data.harmny = d.harmny; notify(); return true }catch{return false} }
function pushHistory(){ if(paused) return; const snap = exportData(); if(historyIdx < history.length-1) history = history.slice(0, historyIdx+1); history.push(snap); if(history.length>MAX_HISTORY) history.shift(); historyIdx = history.length-1 }
function notify(){ pushHistory(); listeners.forEach(fn=>fn(data)) }
function subscribe(fn){ listeners.push(fn); return ()=>{ const i = listeners.indexOf(fn); if(i>-1) listeners.splice(i,1) } }
function undo(){ if(historyIdx<=0) return false; historyIdx--; paused=true; importData(history[historyIdx]); paused=false; return true }
function redo(){ if(historyIdx>=history.length-1) return false; historyIdx++; paused=true; importData(history[historyIdx]); paused=false; return true }
return {get, set, addEnt, updEnt, delEnt, lnkEnts, getEntsByTy, getAllEnts, getRels, getTotalWordCount, exportData, importData, subscribe, undo, redo, canUndo:()=>historyIdx>0, canRedo:()=>historyIdx<history.length-1}
})()

/* ===== ExportMgr ===================================================== */
const ExportMgr = (function(S){
function exportEAS(){
 const seed = S.get('seed'); let out = '# JhnTwain EAS v1\n'
 if(seed.title) out += `!story "${seed.title}"\n`
 if(seed.target) out += ` target ${seed.target}\n`
 if(seed.theme) out += ` theme ${seed.theme}\n`
 if(seed.premise) out += ` premise "${seed.premise}"\n`
 out += '\n'
 const pre = {character:'@char',scene:'@scene',conflict:'@conflict',research:'@research',storycard:'@card',thread:'@thread'}
 S.getAllEnts().forEach(ent=>{
  const p = pre[ent.type] || '@'+ent.type
  out += `${p} ${ent.attrs.name || ent.id}\n`
  Object.keys(ent.attrs).forEach(k=>{ if(k==='name') return; const v = ent.attrs[k]; if(v.includes('\n') || v.length>40) out += ` ${k}\n ${v}\n`; else out += ` ${k} ${v}\n` })
  out += '\n'
 })
 return out
}
function exportManuscript(){
 const seed = S.get('seed'), blks = S.get('proseBlks')
 let ms = ''
 if(seed.title) ms += seed.title + '\n\n'
 blks.forEach(b=>{ if(b.text) ms += b.text + '\n\n' })
 return ms.trim()
}
function importEAS(txt){
 const parsed = AppPlugins.parseEAS(txt)
 parsed.forEach(p=> S.addEnt(p.type.replace('@',''), p.attrs))
 return parsed.length
}
return {exportEAS, exportManuscript, importEAS}
})(JhnTwainState)

/* ===== BlobIO ========================================================= */
const BlobIO = (function(U, S, Ex){
let ta = null
function mkPanel(){
 const p = U.crtEl('div','jtw-pnl'); p.id = 'blobPnl'
 const ttl = U.crtEl('div','jtw-section-ttl'); ttl.textContent = '📋 Blob IO'
 ta = U.crtEl('textarea','jtw-txa'); ta.style.minHeight = '240px'; ta.placeholder = 'Paste EAS / prose / mixed text here…'
 const row = U.crtEl('div','jtw-row')
 const loadBtn = U.crtEl('button','jtw-btn jtw-btn-pri'); loadBtn.textContent = '⬆ Accept Blob'
 loadBtn.onclick = acceptBlob
 const dumpBtn = U.crtEl('button','jtw-btn jtw-btn-sec'); dumpBtn.textContent = '⬇ Dump State'
 dumpBtn.onclick = dumpBlob
 const clrBtn = U.crtEl('button','jtw-btn jtw-btn-dng'); clrBtn.textContent = '🗑 Clear'; clrBtn.onclick = ()=> ta.value = ''
 U.appndChld(row, loadBtn, dumpBtn, clrBtn)
 U.appndChld(p, ttl, ta, row)
 return p
}
function acceptBlob(){
 const raw = ta.value.trim(); if(!raw) return
 const parsed = AppPlugins.parseEAS(raw)
 if(parsed.length){
  parsed.forEach(p=> S.addEnt(p.type.replace('@',''), p.attrs))
  AppPlugins.toast('Loaded '+parsed.length+' entities','success')
 }else{
  const blks = raw.split(/\n\n+/).filter(Boolean)
  blks.forEach(b=> S.get('proseBlks').push({id:'blk-'+Date.now().toString(36), text:b, symphony:{}}))
  AppPlugins.toast('Loaded '+blks.length+' prose blocks','success')
 }
 JhnTwainUIX.refreshAll()
}
function dumpBlob(){ ta.value = Ex.exportEAS(); ta.select() }
return {mkPanel}
})(Utils, JhnTwainState, ExportMgr)

