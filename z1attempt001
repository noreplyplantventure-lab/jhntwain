  }
  if(actions && actions.length){
   const actRow = Utils.crtEl('div','jtw-modal-acts')
   Utils.regCss(actRow,{
    display:'flex', gap:'8px', justifyContent:'flex-end', marginTop:'20px'
   })
   for(let i = 0; i < actions.length; i++){
    const act = actions[i]
    const btn = Utils.crtEl('button','jtw-modal-act-btn')
    btn.textContent = act.label
    Utils.regCss(btn,{
     padding:'10px 20px', borderRadius:'8px', border:'none', cursor:'pointer',
     fontSize:'13px', fontWeight:'500',
     background: act.primary ? 'linear-gradient(135deg, #00ccaa 0%, #00a88a 100%)' : '#2a3040',
     color: act.primary ? '#0a0e14' : '#e0e4ec',
     transition:'all 0.2s ease', boxShadow: act.primary ? '0 2px 8px rgba(0,204,170,0.3)' : 'none'
    })
    btn.addEventListener('click', act.fn)
    actRow.appendChild(btn)
   }
   modal.appendChild(actRow)
  }
  modalOverlay.appendChild(modal)
  modalOverlay.addEventListener('click', function(e){
   if(e.target === modalOverlay) hideModal()
  })
  document.body.appendChild(modalOverlay)
 }
 function hideModal(){
  if(modalOverlay && modalOverlay.parentNode) modalOverlay.parentNode.removeChild(modalOverlay)
  modalOverlay = null
 }
 return {
  createCardBase:createCardBase, parseTextToEntities:parseTextToEntities,
  drawLink:drawLink, showModal:showModal, hideModal:hideModal, showToast:showToast
 }
})()


const JhnTwain = (function(){
 const JhnTwainState = (function(){
  let data = {
   seed:{title:'',target:0,theme:'',premise:'',seedTxt:''},
   entities:new Map(),
   proseBlks:[],
   relations:[],
   harmny:{
    conductor:{harmony:50,tempo:'steady',openThreads:[]},
    narrTrain:{momentum:'building',nextBeat:'inciting-incident'},
    multiverse:{branches:[],violations:[]}
   }
  }
  const listeners = []
  let history = []
  let historyIdx = -1
  const MAX_HISTORY = 50
  let historyPaused = false
  function get(path){
   if(!path) return data
   const parts = path.split('.')
   let cur = data
   for(let i = 0; i < parts.length; i++){
    if(cur === undefined || cur === null) return undefined
    cur = cur[parts[i]]
   }
   return cur
  }
  function set(path, val){
   const parts = path.split('.')
   let cur = data
   for(let i = 0; i < parts.length - 1; i++){
    if(cur[parts[i]] === undefined) cur[parts[i]] = {}
    cur = cur[parts[i]]
   }
   cur[parts[parts.length-1]] = val
   notify()
  }
  function addEnt(ty, init){
   const id = ty + '-' + Date.now().toString(36) + Math.random().toString(36).substr(2,4)
   const ent = {
    id:id, type:ty,
    meta:{created:Date.now(),modified:Date.now()},
    attrs:{name:'', ...init},
    color: getEntColor(ty), icon: getEntIcon(ty)
   }
   data.entities.set(id, ent)
   notify()
   return ent
  }
  function updEnt(id, changes){
   const ent = data.entities.get(id)
   if(!ent) return null
   if(changes.attrs){
    const attrKeys = Object.keys(changes.attrs)
    for(let i = 0; i < attrKeys.length; i++) ent.attrs[attrKeys[i]] = changes.attrs[attrKeys[i]]
   }
   ent.meta.modified = Date.now()
   notify()
   return ent
  }
  function getEntsByTy(ty){
   const results = []
   data.entities.forEach(function(ent){ if(ent.type === ty) results.push(ent) })
   return results
  }
  function delEnt(id){
   data.entities.delete(id)
   data.relations = data.relations.filter(function(r){ return r.src !== id && r.tgt !== id })
   notify()
  }
  function lnkEnts(srcId, tgtId, lnkTy){
   data.relations.push({src:srcId, tgt:tgtId, type:lnkTy||'involves'})
   notify()
  }
  function getRels(){ return data.relations }
  function getEntById(id){ return data.entities.get(id) }
  function getAllEnts(){
   const arr = []
   data.entities.forEach(function(v){ arr.push(v) })
   return arr
  }
  function getEntColor(ty){
   const colors = {
    character:'#00ccaa', scene:'#ffaa00', conflict:'#ff5555',
    research:'#7777ff', storycard:'#cc88ff', thread:'#88ccff',
    conductor:'#ffff77', narrTrain:'#ff77aa', multiverse:'#aa77ff'
   }
   return colors[ty] || '#00ccaa'
  }
  function getEntIcon(ty){
   const icons = {
    character:'\u{1F464}', scene:'\u{1F4CD}', conflict:'\u2694\uFE0F',
    research:'\u{1F4DA}', storycard:'\u{1F0CF}', thread:'\u{1F501}',
    conductor:'\u{1F3BC}', narrTrain:'\u{1F682}', multiverse:'\u{1F30C}'
   }
   return icons[ty] || '\u25CF'
  }
  function getTotalWordCount(){
   let total = 0
   const blks = data.proseBlks
   for(let i = 0; i < blks.length; i++){
    total += Utils.countWords(blks[i].text)
   }
   total += Utils.countWords(data.seed.seedTxt)
   return total
  }
  function exportData(){
   return JSON.stringify({
    seed:data.seed, entities:Array.from(data.entities.entries()),
    proseBlks:data.proseBlks, relations:data.relations, harmny:data.harmny
   })
  }
  function importData(jsonStr){
   try{
    const d = JSON.parse(jsonStr)
    if(d.seed) data.seed = d.seed
    if(d.entities) data.entities = new Map(d.entities)
    if(d.proseBlks) data.proseBlks = d.proseBlks
    if(d.relations) data.relations = d.relations
    if(d.harmny) data.harmny = d.harmny
    notify()
    return true
   } catch(e){ return false }
  }
  function subscribe(fn){
   listeners.push(fn)
   return function(){
    const idx = listeners.indexOf(fn)
    if(idx !== -1) listeners.splice(idx,1)
   }
  }
  function pushHistory(){
   if(historyPaused) return
   const snapshot = exportData()
   if(historyIdx < history.length - 1){
    history = history.slice(0, historyIdx + 1)
   }
   history.push(snapshot)
   if(history.length > MAX_HISTORY){
    history.shift()
   }
   historyIdx = history.length - 1
  }
  function undo(){
   if(historyIdx <= 0) return false
   historyIdx--
   historyPaused = true
   importData(history[historyIdx])
   historyPaused = false
   return true
  }
  function redo(){
   if(historyIdx >= history.length - 1) return false
   historyIdx++
   historyPaused = true
   importData(history[historyIdx])
   historyPaused = false
   return true
  }
  function canUndo(){ return historyIdx > 0 }
  function canRedo(){ return historyIdx < history.length - 1 }
  function notify(){
   pushHistory()
   for(let i = 0; i < listeners.length; i++) listeners[i](data)
  }
  return {
   get:get, set:set, addEnt:addEnt, updEnt:updEnt,
   getEntsByTy:getEntsByTy, delEnt:delEnt, lnkEnts:lnkEnts,
   getRels:getRels, getEntById:getEntById, getAllEnts:getAllEnts,
   exportData:exportData, importData:importData, subscribe:subscribe,
   getTotalWordCount:getTotalWordCount,
   undo:undo, redo:redo, canUndo:canUndo, canRedo:canRedo
  }
 })()


