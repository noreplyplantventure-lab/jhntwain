const Utils = (function(){
 const cssRgstry = {
  props:[],
  map:new Map()
 }
 function getOrAddPropIdx(propName){
  let idx = cssRgstry.props.indexOf(propName)
  if(idx === -1){
   idx = cssRgstry.props.length
   cssRgstry.props.push(propName)
  }
  return idx
 }
 function regCss(el, styleObj){
  if(!el || !styleObj) return el
  let entry = cssRgstry.map.get(el)
  if(!entry){
   entry = [[],[]]
   cssRgstry.map.set(el, entry)
  }
  const keys = Object.keys(styleObj)
  for(let i = 0; i < keys.length; i++){
   const pName = keys[i]
   const pVal = styleObj[pName]
   const pIdx = getOrAddPropIdx(pName)
   const existIdx = entry[0].indexOf(pIdx)
   if(existIdx !== -1){
    entry[1][existIdx] = pVal
   } else {
    entry[0].push(pIdx)
    entry[1].push(pVal)
   }
  }
  applyCssToEl(el, entry)
  return el
 }
 function applyCssToEl(el, entry){
  if(!entry) return
  const propIdxs = entry[0]
  const propVals = entry[1]
  for(let i = 0; i < propIdxs.length; i++){
   const pName = cssRgstry.props[propIdxs[i]]
   const pVal = propVals[i]
   if(pName && el.style) el.style[pName] = pVal
  }
 }
 function applyAllCss(){
  cssRgstry.map.forEach(function(entry, el){ applyCssToEl(el, entry) })
 }
 function rmCssEntry(el){ cssRgstry.map.delete(el) }
 function crtEl(tag, cls, txt){
  const el = document.createElement(tag)
  if(cls) el.className = cls
  if(txt){
   const tn = document.createTextNode(txt)
   el.appendChild(tn)
  }
  return el
 }
 function appndChld(prnt){
  for(let i = 1; i < arguments.length; i++){
   if(arguments[i]) prnt.appendChild(arguments[i])
  }
  return prnt
 }
 function clrChld(el){
  while(el.firstChild) el.removeChild(el.firstChild)
  rmCssEntry(el)
  return el
 }
 const evntBus = {}
 function pub(topic, data){
  if(!evntBus[topic]) return
  for(let i = 0; i < evntBus[topic].length; i++) evntBus[topic][i](data)
 }
 function sub(topic, fn){
  if(!evntBus[topic]) evntBus[topic] = []
  evntBus[topic].push(fn)
  return function(){
   const idx = evntBus[topic].indexOf(fn)
   if(idx !== -1) evntBus[topic].splice(idx, 1)
  }
 }
 function saveToStore(key, val){
  try{ localStorage.setItem('jtw_'+key, JSON.stringify(val)) } catch(e){}
 }
 function loadFromStore(key){
  try{
   const raw = localStorage.getItem('jtw_'+key)
   return raw ? JSON.parse(raw) : null
  } catch(e){ return null }
 }
 function dragInit(el, cbs){
  let isDrag = false
  let startX = 0
  let startY = 0
  let origX = 0
  let origY = 0
  function onDown(e){
   if(e.target.tagName === 'INPUT' || e.target.tagName === 'TEXTAREA' || e.target.tagName === 'SELECT' || e.target.isContentEditable) return
   isDrag = true
   const touch = e.touches ? e.touches[0] : e
   startX = touch.clientX
   startY = touch.clientY
   origX = parseInt(el.getAttribute('data-x')) || 0
   origY = parseInt(el.getAttribute('data-y')) || 0
   regCss(el, {zIndex:'10', boxShadow:'0 8px 24px rgba(0,204,170,0.25)'})
   if(cbs && cbs.onDown) cbs.onDown(e, origX, origY)
   e.preventDefault()
  }
  function onMove(e){
   if(!isDrag) return
   const touch = e.touches ? e.touches[0] : e
   const dx = touch.clientX - startX
   const dy = touch.clientY - startY
   const nx = origX + dx
   const ny = origY + dy
   el.setAttribute('data-x', nx)
   el.setAttribute('data-y', ny)
   regCss(el, {transform:'translate('+nx+'px,'+ny+'px)'})
   if(cbs && cbs.onMove) cbs.onMove(e, nx, ny)
  }
  function onUp(e){
   if(!isDrag) return
   isDrag = false
   regCss(el, {zIndex:'1', boxShadow:'0 2px 8px rgba(0,0,0,0.3)'})
   const nx = parseInt(el.getAttribute('data-x')) || 0
   const ny = parseInt(el.getAttribute('data-y')) || 0
   if(cbs && cbs.onUp) cbs.onUp(e, nx, ny)
  }
  el.addEventListener('mousedown', onDown)
  document.addEventListener('mousemove', onMove)
  document.addEventListener('mouseup', onUp)
  el.addEventListener('touchstart', onDown, {passive:false})
  document.addEventListener('touchmove', onMove, {passive:false})
  document.addEventListener('touchend', onUp)
  return {
   destroy: function(){
    el.removeEventListener('mousedown', onDown)
    document.removeEventListener('mousemove', onMove)
    document.removeEventListener('mouseup', onUp)
   }
  }
 }
 function countWords(txt){
  if(!txt) return 0
  return txt.trim().split(/\s+/).filter(function(w){ return w.length > 0 }).length
 }
 return {
  crtEl:crtEl, appndChld:appndChld, clrChld:clrChld, regCss:regCss,
  pub:pub, sub:sub, saveToStore:saveToStore, loadFromStore:loadFromStore,
  dragInit:dragInit, cssRgstry:cssRgstry, applyAllCss:applyAllCss,
  rmCssEntry:rmCssEntry, countWords:countWords
 }
})()


