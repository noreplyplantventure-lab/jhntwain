   background:'linear-gradient(135deg, #1e2436 0%, #151a28 100%)',
   borderRadius:'14px', padding:'28px', minWidth:'340px', maxWidth:'560px',
   maxHeight:'80vh', overflowY:'auto',
   boxShadow:'0 12px 40px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.05)',
   color:'#e0e4ec', animation:'jtwSlideUp 0.3s ease'
  })
  if(typeof content === 'string'){
   const txt = Utils.crtEl('div','jtw-modal-txt')
   txt.textContent = content
   Utils.regCss(txt,{marginBottom:'16px', lineHeight:'1.6', whiteSpace:'pre-wrap'})
