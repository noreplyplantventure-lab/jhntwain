 const hero = U.crtEl('div','jtw-seed-hero')
 const ttl = U.crtEl('div','jtw-seed-hero-ttl'); ttl.textContent = seed.title || 'Untitled Story'
 const sub = U.crtEl('div','jtw-seed-hero-sub'); sub.textContent = `${S.getTotalWordCount()} words / ${seed.target} target`
 U.appndChld(hero, ttl, sub); p.appendChild(hero)
 function fld(lbl, tag, key, ph){
