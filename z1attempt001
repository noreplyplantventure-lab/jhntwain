Root cause
renderSeed() is called on every keystroke because JhnTwainState.subscribe(renderSeed) (via refreshAll) is triggered by set('seed.title', …).
Inside renderSeed() the entire panel is emptied (U.clrChld(p)) and all input elements are re-created. The newly-created <input> is therefore a different DOM node; the browser can no longer keep focus on it, so the caret disappears after every character.

Same pattern exists in:

renderProse() – re-creates every prose-block textarea on every keystroke.
All renderEntPanel() calls – re-creates every card and every inline-editable field.
Fix
Only rebuild the parts that must change (word-count badges, tab badges, etc.) and keep the existing inputs/cards in place. Below is the minimal patch that keeps the single-file spirit and removes the destructive re-creation.

Drop-in patch (add after last <script> tag)

HTML

Copy
<script>
/* ===== Patch: stop destroying inputs on every keystroke =========== */
/* 1.  Seed panel – keep inputs, only update badges & hero text */
const origRenderSeed = JhnTwainUIX.renderSeed
JhnTwainUIX.renderSeed = function () {
  const p = JhnTwainUIX.panels.seed
  if (!p) return
  /* hero only */
  const hero = p.querySelector('.jtw-seed-hero')
  const sub  = hero.querySelector('.jtw-seed-hero-sub')
  const seed = JhnTwainState.get('seed')
  const wc   = JhnTwainState.getTotalWordCount()
  const tgt  = seed.target || 5000
  sub.textContent = `${wc} words of ${tgt} target · ${seed.theme || 'No theme'}`
  /* inputs already exist; update their .value without re-creating */
  p.querySelector('input[placeholder*="Give your story"]').value = seed.title || ''
  p.querySelector('input[type="number"]').value = tgt
  p.querySelector('input[placeholder*="Theme"]').value = seed.theme || ''
  p.querySelector('textarea[placeholder*="Premise"]').value = seed.premise || ''
  p.querySelector('textarea[placeholder*="Seed"]').value = seed.seedTxt || ''
}

/* 2.  Prose panel – keep blocks, only update word counts */
const origRenderProse = JhnTwainUIX.renderProse
JhnTwainUIX.renderProse = function () {
  const p = JhnTwainUIX.panels.prose
  if (!p) return
  const blks = JhnTwainState.get('proseBlks')
  blks.forEach((blk, i) => {
    const blockEl = p._cont.children[i]
    if (!blockEl) return // new block – handled elsewhere
    const wcSpan = blockEl.querySelector('.jtw-prose-wc')
    wcSpan.textContent = Utils.countWords(blk.text) + ' words'
  })
}

/* 3.  Entity panels – keep cards, only update badges */
const origRenderEntPanel = JhnTwainUIX.renderEntPanel
JhnTwainUIX.renderEntPanel = function (ty) {
  const p = JhnTwainUIX.panels[ty.replace('s','')]
  if (!p) return
  /* only update tab badge */
  const btn = JhnTwainUIX.tabBtns[ty.replace('s','')]
  if (btn) {
    const badge = btn.querySelector('.jtw-tab-badge')
    if (badge) badge.textContent = JhnTwainState.getEntsByTy(ty).length
  }
}

/* 4.  Stop full refresh on every state change */
JhnTwainState.subscribe(() => {
  JhnTwainUIX.updateHeader()
  JhnTwainUIX.updateBadges()
})
</script>
With these four overrides the title input, prose textareas, and inline-editable attribute fields retain focus across keystrokes.
