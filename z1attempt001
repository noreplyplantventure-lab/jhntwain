 U.regCss(badge,{display:'inline-block',padding:'1px 6px',borderRadius:'3px',fontSize:'10px',fontWeight:'600',textTransform:'uppercase',letterSpacing:'0.5px',background:(ent.color||'#00ccaa')+'25',color:ent.color||'#00ccaa'})
 const body = U.crtEl('div','jtw-card-body')
