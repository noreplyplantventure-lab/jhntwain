  function makeInlineEditable(row, vEl, ent, key){
   const editIcon = U.crtEl('span','jtw-card-attr-edit-icon')
   editIcon.textContent = '\u270E'
   row.appendChild(editIcon)
   function startEdit(){
    const currentVal = ent.attrs[key] || ''
    const inp = U.crtEl('input','jtw-inp')
    inp.value = currentVal
    inp.style.fontSize = '12px'
    inp.style.padding = '2px 6px'
    inp.style.minWidth = '60px'
    row.replaceChild(inp, vEl)
    inp.focus()
    inp.select()
    function saveEdit(){
     ent.attrs[key] = inp.value
     ent.meta.modified = Date.now()
     vEl.textContent = inp.value
     if(row.parentNode){
      try{ row.replaceChild(vEl, inp) } catch(e){}
     }
     row.appendChild(editIcon)
    }
    function cancelEdit(){
     if(row.parentNode){
      try{ row.replaceChild(vEl, inp) } catch(e){}
     }
     row.appendChild(editIcon)
    }
    inp.addEventListener('blur', saveEdit)
    inp.addEventListener('keydown', function(e){
     if(e.key === 'Enter'){
      e.preventDefault()
      inp.blur()
     } else if(e.key === 'Escape'){
      inp.removeEventListener('blur', saveEdit)
      cancelEdit()
     }
    })
   }
   vEl.addEventListener('click', function(e){
    e.stopPropagation()
    startEdit()
   })
  }
