 const JhnTwainCore = (function(S, UIX){
  let autoSaveTimer = null
  function init(){
   loadSaved()
   startAutoSave()
   S.subscribe(function(){ UIX.refreshAll() })
   initKeyboard()
  }
  function loadSaved(){
   const d = Utils.loadFromStore('project')
   if(d) S.importData(d)
  }
  function handleAction(action, payload){
   switch(action){
    case 'addEnt': S.addEnt(payload.type, payload.init); break
    case 'delEnt': S.delEnt(payload.id); break
    case 'updEnt': S.updEnt(payload.id, payload.changes); break
    case 'lnkEnts': S.lnkEnts(payload.src, payload.tgt, payload.type); break
   }
  }
  function syncUI(){ UIX.refreshAll() }
  function autoSave(){
   Utils.saveToStore('project', S.exportData())
  }
  function startAutoSave(){
   if(autoSaveTimer) clearInterval(autoSaveTimer)
   autoSaveTimer = setInterval(function(){ autoSave() }, 30000)
  }
  function initKeyboard(){
   document.addEventListener('keydown', function(e){
    if(e.ctrlKey || e.metaKey){
     if(e.key === 's'){
      e.preventDefault()
      autoSave()
      AppPlugins.showToast('Project saved!', 'success')
     }
     if(e.key === 'e'){
      e.preventDefault()
      const eas = ExportMgr.exportEAS()
      Utils.saveToStore('lastEas', eas)
      AppPlugins.showToast('EAS exported to clipboard!', 'success')
     }
     if(e.key === 'z' && !e.shiftKey){
      e.preventDefault()
      if(S.undo()){
       AppPlugins.showToast('Undone', 'info')
       UIX.refreshAll()
      }
     }
     if(e.key === 'z' && e.shiftKey){
      e.preventDefault()
      if(S.redo()){
       AppPlugins.showToast('Redone', 'info')
       UIX.refreshAll()
      }
     }
     if(e.key === 'Z'){
      e.preventDefault()
      if(S.redo()){
       AppPlugins.showToast('Redone', 'info')
       UIX.refreshAll()
      }
     }
    }
   })
  }
  return { init:init, handleAction:handleAction, syncUI:syncUI, autoSave:autoSave }
 })(JhnTwainState, JhnTwainUIX)


 const EntityMgr = (function(S){
  const entTypes = {
   char:{prefix:'@char',defaults:['name','aspect'],color:'#0ca'},
   scene:{prefix:'@scene',defaults:['time','prose']},
   conflict:{prefix:'@conflict',defaults:['type','magnitude','state']},
   research:{prefix:'@research',defaults:['topic','notes']},
   storycard:{prefix:'@card',defaults:['content','attachedTo','type']},
   thread:{prefix:'@thread',defaults:['name','motif','appearsIn']},
   conductor:{prefix:'@conductor',defaults:['harmony','tempo'],singleton:true},
   narrTrain:{prefix:'@train',defaults:['momentum','nextBeat'],singleton:true},
   multiverse:{prefix:'@multiverse',defaults:['branches','violations'],singleton:true}
  }
  function crtEnt(ty, initData){
   if(!entTypes[ty]) return null
   return S.addEnt(ty, initData || {})
  }
  function updAttr(id, attrPath, val){
   const ent = S.getEntById(id)
   if(!ent) return null
   if(!ent.attrs) ent.attrs = {}
   ent.attrs[attrPath] = val
   ent.meta.modified = Date.now()
   return ent
  }
  function getByTy(ty){ return S.getEntsByTy(ty) }
  function getById(id){ return S.getEntById(id) }
  function delEnt(id){ S.delEnt(id) }
  function lnkEnts(srcId, tgtId, lnkTy){ S.lnkEnts(srcId, tgtId, lnkTy) }
  function toEAS(){ return ExportMgr.exportEAS() }
  function fromEAS(txt){
   const parsed = AppPlugins.parseTextToEntities(txt)
   for(let i = 0; i < parsed.length; i++){
    const p = parsed[i]
    const ty = p.type.replace('@','')
    S.addEnt(ty, p.attrs)
   }
  }
  function addCustomTy(newTyCfg){
   if(!newTyCfg || !newTyCfg.key || !newTyCfg.prefix) return
   entTypes[newTyCfg.key] = {
    prefix:newTyCfg.prefix, defaults:newTyCfg.defaults||[],
    color:newTyCfg.color||'#00ccaa', singleton:newTyCfg.singleton||false
   }
  }
  function valAttr(ent, attr, val){
   if(!ent || !ent.attrs) return false
   return ent.attrs[attr] === val
  }
  return {
   crtEnt:crtEnt, updAttr:updAttr, getByTy:getByTy, getById:getById,
   delEnt:delEnt, lnkEnts:lnkEnts, toEAS:toEAS, fromEAS:fromEAS,
   addCustomTy:addCustomTy, valAttr:valAttr
  }
 })(JhnTwainState)


 const StorySeed = (function(S){
  function updSeed(field, val){ S.set('seed.'+field, val) }
  function getSeed(){ return S.get('seed') }
  return {updSeed:updSeed, getSeed:getSeed}
 })(JhnTwainState)


 const ProseEngine = (function(S){
  function saveProse(txt){
   S.get('proseBlks').push({id:'blk-'+Date.now().toString(36), text:txt, symphony:{distance:'',chord:''}})
  }
  function getManuscript(){
   const blks = S.get('proseBlks')
   let ms = ''
   for(let i = 0; i < blks.length; i++){
    if(blks[i].text) ms += blks[i].text + '\n\n'
   }
   return ms.trim()
  }
  function applySymphony(blockId, attrs){
   const blks = S.get('proseBlks')
   for(let i = 0; i < blks.length; i++){
    if(blks[i].id === blockId){
     blks[i].symphony = Object.assign(blks[i].symphony || {}, attrs)
     break
    }
   }
  }
  return {saveProse:saveProse, getManuscript:getManuscript, applySymphony:applySymphony}
 })(JhnTwainState)


 const HarmonyLayer = (function(S){
  function getConductor(){ return S.get('harmny.conductor') }
  function getNarrativeTrain(){ return S.get('harmny.narrTrain') }
  function checkConsistency(){
   const ents = S.getAllEnts()
   const viol = []
   const nameMap = {}
   for(let i = 0; i < ents.length; i++){
    const ent = ents[i]
    if(ent.attrs.name){
     if(nameMap[ent.attrs.name] && nameMap[ent.attrs.name] !== ent.id) viol.push('Duplicate name: '+ent.attrs.name)
     nameMap[ent.attrs.name] = ent.id
    }
   }
   const blks = S.get('proseBlks')
   if(blks.length === 0) viol.push('No prose written yet')
   const chars = S.getEntsByTy('character')
   if(chars.length === 0) viol.push('No characters defined')
   const conflicts = S.getEntsByTy('conflict')
   const activeConf = conflicts.filter(function(c){ return c.attrs.state === 'active' })
   if(activeConf.length === 0 && blks.length > 2) viol.push('No active conflicts - story may stall')
   if(activeConf.length > 5) viol.push('Too many active conflicts - may overwhelm reader')
   if(viol.length === 0) viol.push('All checks passed')
   S.set('harmny.multiverse.violations', viol)
   const harmony = Math.max(10, 100 - (viol.length * 15))
   S.set('harmny.conductor.harmony', harmony)
   JhnTwainUIX.renderHarmny()
   const msg = viol.join('\n')
   AppPlugins.showModal(msg, [{label:'OK', primary:true, fn:AppPlugins.hideModal}])
   return viol
  }
  function suggestNext(){
   const train = S.get('harmny.narrTrain')
   const blks = S.get('proseBlks')
   const chars = S.getEntsByTy('character')
   const conflicts = S.getEntsByTy('conflict')
   if(blks.length < 2) return 'Write more prose before seeking suggestions'
   if(chars.length < 2) return 'Add more characters to develop interactions'
   const activeConf = conflicts.filter(function(c){ return c.attrs.state === 'active' })
   if(activeConf.length === 0) return 'Introduce a conflict to drive the story forward'
   if(train.momentum === 'stalled') return 'Try a short action beat or dialogue to restore momentum'
   if(train.momentum === 'cruising') return 'Good momentum. Consider raising the stakes or adding a twist'
   return 'Story is progressing well. Keep writing'
  }
  return {
   getConductor:getConductor, getNarrativeTrain:getNarrativeTrain,
   checkConsistency:checkConsistency, suggestNext:suggestNext
  }
 })(JhnTwainState)


 const Workspace = (function(S, UIX){
  function renderCanvas(){ UIX.renderWorkspace() }
  function handleCardDrop(id, x, y){}
  function updateCardPos(id, x, y){}
  function renderLinks(){}
  return {renderCanvas:renderCanvas, handleCardDrop:handleCardDrop, updateCardPos:updateCardPos, renderLinks:renderLinks}
 })(JhnTwainState, JhnTwainUIX)


 const ExportMgr = (function(S){
  function exportEAS(){
   const seed = S.get('seed')
   let eas = '# JhnTwain EAS v1\n'
   if(seed.title) eas += '!story "'+seed.title+'"\n'
   if(seed.target) eas += '    target '+seed.target+'\n'
   if(seed.theme) eas += '    theme '+seed.theme+'\n'
   if(seed.premise) eas += '    premise "'+seed.premise+'"\n'
   eas += '\n'
   const ents = S.getAllEnts()
   const typePrefix = {
    character:'@char', scene:'@scene', conflict:'@conflict',
    research:'@research', storycard:'@card', thread:'@thread',
    conductor:'@conductor', narrTrain:'@train', multiverse:'@multiverse'
   }
   for(let i = 0; i < ents.length; i++){
    const ent = ents[i]
    const prefix = typePrefix[ent.type] || '@'+ent.type
    const name = ent.attrs.name || ent.id
    eas += prefix+' '+name+'\n'
    const attrKeys = Object.keys(ent.attrs)
    for(let j = 0; j < attrKeys.length; j++){
     const key = attrKeys[j]
     if(key === 'name') continue
     const val = ent.attrs[key]
     if(val){
      if(val.length > 40 || val.indexOf('\n') !== -1) eas += '    '+key+'\n        '+val+'\n'
      else eas += '    '+key+' '+val+'\n'
     }
    }
    eas += '\n'
   }
   return eas
  }
  function exportManuscript(){
   const seed = S.get('seed')
   const blks = S.get('proseBlks')
   let ms = ''
   if(seed.title) ms += seed.title + '\n\n'
   for(let i = 0; i < blks.length; i++){
    if(blks[i].text) ms += blks[i].text + '\n\n'
   }
   return ms.trim()
  }
  function importEAS(txt){
   const parsed = AppPlugins.parseTextToEntities(txt)
   for(let i = 0; i < parsed.length; i++){
    const p = parsed[i]
    const ty = p.type.replace('@','')
    S.addEnt(ty, p.attrs)
   }
   return parsed.length
  }
  return {exportEAS:exportEAS, exportManuscript:exportManuscript, importEAS:importEAS}
 })(JhnTwainState)


 function init(){
  JhnTwainUIX.buildUI()
  JhnTwainCore.init()
 }
 return {
  init:init, EntityMgr:EntityMgr, StorySeed:StorySeed, ProseEngine:ProseEngine,
  HarmonyLayer:HarmonyLayer, Workspace:Workspace, ExportMgr:ExportMgr
 }
})()

JhnTwain.init()
 </script>
