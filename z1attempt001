  function updateWordCount(hdrEl){
   if(!hdrEl) return
   const wc = S.getTotalWordCount()
   const target = S.get('seed.target') || 5000
   const pct = Math.min(100, Math.round((wc / target) * 100))
   if(hdrEl._wcFill) Utils.regCss(hdrEl._wcFill, {width:pct+'%'})
   if(hdrEl._wcTxt) hdrEl._wcTxt.textContent = wc+' / '+target
   if(hdrEl._undoBtn){
    hdrEl._undoBtn.disabled = !S.canUndo()
    Utils.regCss(hdrEl._undoBtn,{opacity: S.canUndo()?'1':'0.4'})
   }
   if(hdrEl._redoBtn){
    hdrEl._redoBtn.disabled = !S.canRedo()
    Utils.regCss(hdrEl._redoBtn,{opacity: S.canRedo()?'1':'0.4'})
   }
  }
  function buildTabBar(){
   const bar = U.crtEl('div','jtw-tab-bar')
   for(let i = 0; i < tabDefs.length; i++){
    const td = tabDefs[i]
    const btn = U.crtEl('button','jtw-tab-btn')
    const lblSpan = U.crtEl('span','')
    lblSpan.textContent = td.label
    btn.appendChild(lblSpan)
    if(td.entTy){
     const badge = U.crtEl('span','jtw-tab-badge')
     badge.textContent = '0'
     badge._entTy = td.entTy
     btn.appendChild(badge)
    }
    if(td.key === activeTab) btn.classList.add('active')
    btn.addEventListener('click', function(){ switchTab(td.key) })
    bar.appendChild(btn)
    tabBtns[td.key] = btn
   }
   return bar
  }
  function updateTabBadges(){
   const btnKeys = Object.keys(tabBtns)
   for(let i = 0; i < btnKeys.length; i++){
    const btn = tabBtns[btnKeys[i]]
    if(!btn) continue
    const badges = btn.querySelectorAll('.jtw-tab-badge')
    for(let j = 0; j < badges.length; j++){
     const badge = badges[j]
     if(badge._entTy){
      const count = S.getEntsByTy(badge._entTy).length
      badge.textContent = String(count)
     }
    }
   }
  }
  function switchTab(key){
   activeTab = key
   const panelKeys = Object.keys(panels)
   for(let i = 0; i < panelKeys.length; i++){
    if(panels[panelKeys[i]]){
     if(panelKeys[i] === key){
      panels[panelKeys[i]].classList.remove('hidden')
      panels[panelKeys[i]].classList.remove('jtw-pnl-fadein')
      void panels[panelKeys[i]].offsetWidth
      panels[panelKeys[i]].classList.add('jtw-pnl-fadein')
     } else {
      panels[panelKeys[i]].classList.add('hidden')
     }
    }
   }
   const btnKeys = Object.keys(tabBtns)
   for(let i = 0; i < btnKeys.length; i++){
    if(btnKeys[i] === key) tabBtns[btnKeys[i]].classList.add('active')
    else tabBtns[btnKeys[i]].classList.remove('active')
   }
   if(key === 'wrksp') renderWorkspace()
   if(key === 'harmny') renderHarmny()
   if(key === 'seed') renderSeedPnl()
   if(key === 'prose') renderProseBlocks()
   if(key === 'chars') renderEntityPanel('character')
   if(key === 'scenes') renderEntityPanel('scene')
   if(key === 'conflicts') renderEntityPanel('conflict')
   if(key === 'research') renderEntityPanel('research')
   if(key === 'storycards') renderEntityPanel('storycard')
   if(key === 'threads') renderEntityPanel('thread')
   updateStatusBar()
  }
