  document.body.appendChild(toastCont)
 }
 const t = U.crtEl('div','jtw-toast')
 const colors = {success:{bg:'#0d3d30',border:'#00ccaa',text:'#00e6bb'},error:{bg:'#3d0d0d',border:'#ff5555',text:'#ff7777'},info:{bg:'#0d1f3d',border:'#5588cc',text:'#77aaee'},warning:{bg:'#3d2d0d',border:'#ffaa00',text:'#ffcc44'}}
 const c = colors[typ] || colors.info
 U.regCss(t,{padding:'10px 16px',borderRadius:'8px',background:c.bg,border:'1px solid '+c.border,color:c.text,fontSize:'13px',fontFamily:'inherit',boxShadow:'0 4px 12px rgba(0,0,0,0.4)',animation:'jtwSlideIn 0.3s ease',pointerEvents:'auto',maxWidth:'320px',lineHeight:'1.4'})
 t.textContent = msg
