function renderWrksp(){
 if(!canvas || !cardCont) return
 U.clrChld(cardCont)
 const ents = S.getAllEnts()
 if(!ents.length){
  const empty = U.crtEl('div','jtw-empty')
  empty.innerHTML = `<div class="jtw-empty-icon">🖼️</div><div class="jtw-empty-txt">Workspace empty</div><div class="jtw-empty-sub">Add entities via toolbar</div>`
  cardCont.appendChild(empty); return
 }
 ents.forEach((ent,i)=>{
  const card = AppPlugins.createCard(ent)
  if(!wrkspPos[ent.id]){
   const cols = Math.ceil(Math.sqrt(ents.length)), row = Math.floor(i / cols), col = i % cols
   wrkspPos[ent.id] = {x: col * 320 + 24, y: row * 220 + 24}
  }
  const pos = wrkspPos[ent.id]
  card.style.position = 'absolute'
  card.style.transform = `translate(${pos.x}px,${pos.y}px)`
  card._del.onclick = ()=>{ S.delEnt(ent.id); delete wrkspPos[ent.id]; renderWrksp() }
  U.dragInit(card, {
   onMove:(_,nx,ny)=>{ wrkspPos[ent.id] = {x:nx,y:ny}; drawLinks() },
   onUp: drawLinks
  })
  cardCont.appendChild(card)
 })
 drawLinks()
}
function drawLinks(){
 if(!canvas || !cardCont) return
 canvas.width = cardCont.offsetWidth
 canvas.height = cardCont.offsetHeight
 const ctx = canvas.getContext('2d')
 S.getRels().forEach(r=>{
  const src = cardCont.querySelector(`[data-ent-id="${r.src}"]`)
  const tgt = cardCont.querySelector(`[data-ent-id="${r.tgt}"]`)
  if(!src || !tgt) return
  const sr = src.getBoundingClientRect(), tr = tgt.getBoundingClientRect(), cr = canvas.getBoundingClientRect()
  const sx = sr.left + sr.width/2 - cr.left, sy = sr.top + sr.height/2 - cr.top
  const tx = tr.left + tr.width/2 - cr.left, ty = tr.top + tr.height/2 - cr.top
  ctx.beginPath(); ctx.moveTo(sx,sy); ctx.bezierCurveTo(sx, sy+(ty-sy)*0.4, tx, ty-(ty-sy)*0.4, tx, ty)
  ctx.strokeStyle = {involves:'#00ccaa',conflict:'#ff5555',thread:'#88ccff'}[r.type] || '#556677'
  ctx.lineWidth = 2; ctx.setLineDash([6,4]); ctx.globalAlpha = 0.6; ctx.stroke(); ctx.globalAlpha = 1
 })
}
